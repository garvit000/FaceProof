# SerpAPI API Key (Required for Google Lens runtime reverse-image search)
# Get your free key at https://serpapi.com/ (100 free searches/month)
SERPAPI_KEY=your_serpapi_key_here

# Optional: Default crop padding ratio (default: 0.25 = 25% padding)
CROP_PADDING=0.25

# Optional: Face similarity threshold for candidate match verification (default: 0.40)
SIMILARITY_THRESHOLD=0.40
